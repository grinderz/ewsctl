{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Renovate on GitHub keeps uv.lock: exchangelib inside its pyproject range, and a weekly lock refresh for ruff and mypy, which pyproject leaves unpinned.",
    "requires-python moves by hand."
  ],
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "before 9am on saturday"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "semanticCommitType": "chore",
  "baseBranchPatterns": [
    "master"
  ],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "pre-commit"
  ],
  "pre-commit": {
    "enabled": true
  },
  "branchPrefix": "renovate/",
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "update-lockfile",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on saturday"
    ]
  },
  "packageRules": [
    {
      "description": "chore for every update: config:recommended prefixes runtime deps with fix otherwise",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "requires-python is bumped by hand",
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    }
  ]
}
